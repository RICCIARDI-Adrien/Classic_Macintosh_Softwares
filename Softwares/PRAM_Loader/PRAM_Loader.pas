(* Restore the PRAM content from a file. * Author : Adrien RICCIARDI * Date : 10/05/2026 *)program PRAM_Loader;uses Errors, OSIntf;const	FILE_NAME = 'PRAM.bin';function SavePRAM: integer;var	File_PRAM: file of SysParmType;	Result: integer;	Pointer_PRAM_Area: SysPPtr;begin	(* Create the file *)	Rewrite(File_PRAM, FILE_NAME);	Result := IOResult;	if Result <> 0 then	begin		WriteLn('Error while creating the PRAM data file : ', Result);		SavePRAM := Result;		Exit(SavePRAM);	end;		(* Retrieve the PRAM content *)	Pointer_PRAM_Area := GetSysPPtr;		(* Store the PRAM area to the file *)	Write(File_PRAM, Pointer_PRAM_Area^);	Result := IOResult;	if Result <> 0 then	begin		Close(File_PRAM);		WriteLn('Error while creating the PRAM data file : ', Result);		SavePRAM := Result;		Exit(SavePRAM);	end;			Close(File_PRAM);	SavePRAM := 0;end;var	File_PRAM: file;	Result: integer;begin	(* Is the PRAM copy file present ? *)	Reset(File_PRAM, FILE_NAME);	Result := IOResult;	(* The file is present *)	if Result = 0 then	begin		{TODO}	end	(* The file was not found, create it *)	else if Result = fnfErr then	begin		Close(File_PRAM);		Result := SavePRAM;		if Result <> 0 then WriteLn('Error while accessing the PRAM data file : ', Result);	end	else	begin		Close(File_PRAM);		WriteLn('Error while accessing the PRAM data file : ', Result);	end;end.